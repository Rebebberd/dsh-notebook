{
  "name": "dsh-notebook",
  "version": "0.2.3",
  "private": true,
  "description": "NoteBook study spaces for DeepSeek Harness: black-box materials, grounded Q&A, practice questions, and notes",
  "license": "MIT",
  "author": "Rebebberd",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "notebook",
    "study",
    "rag"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rebebberd/dsh-notebook.git"
  },
  "homepage": "https://github.com/Rebebberd/dsh-notebook#readme",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "pdf.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "vendor/katex/*",
    "vendor/katex/fonts/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
